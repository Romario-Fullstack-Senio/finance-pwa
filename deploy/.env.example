# Copiar a deploy/.env. En el servidor, deploy.sh lo genera solo la primera vez.
# Generar valores con: openssl rand -hex 24  /  openssl rand -hex 48
POSTGRES_PASSWORD=cambia-esto
JWT_SECRET=cambia-esto-por-al-menos-32-caracteres-aleatorios

# false = cerrar el registro de cuentas nuevas
ALLOW_SIGNUP=true

# Puerto local (127.0.0.1) donde escucha la web; Tailscale Funnel apunta aquí
WEB_PORT=8090
